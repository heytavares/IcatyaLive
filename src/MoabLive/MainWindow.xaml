<Window x:Class="MoabLive.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="MoabLive · Conexão direta" Width="1240" Height="900" MinWidth="1040" MinHeight="760" Background="#0B101A" Foreground="#E7EDF6" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
<Grid Margin="26"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,20"><StackPanel><TextBlock Text="MoabLive" FontSize="30" FontWeight="Bold"/><TextBlock Text="Tela por conexão direta. Continue na chamada de voz do Discord." Foreground="#93A4BB" Margin="0,4,0,0"/></StackPanel><Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#192538" CornerRadius="12" Padding="14,8"><TextBlock Text="0.3.1 · CONEXÃO" Foreground="#7DD3FC" FontWeight="SemiBold"/></Border></Grid>
<Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="360"/><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#121C2B" CornerRadius="12" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Conectar" FontSize="20" FontWeight="SemiBold"/>
<TextBlock x:Name="RoleHint" Text="Escolha: transmitir sua tela ou assistir a outro PC." Foreground="#7DD3FC" Margin="0,10,0,8" FontWeight="SemiBold"/>
<TextBlock Text="1. Quem compartilha cria o convite." Foreground="#A7B6CA" Margin="0,10,0,8"/>
<Button x:Name="OfferButton" Content="Criar convite para transmitir" Click="CreateOffer" HorizontalAlignment="Left"/>
<TextBlock x:Name="IncomingHint" Text="Para assistir, cole o convite recebido abaixo." Foreground="#A7B6CA" Margin="0,7,0,7"/>
<TextBox x:Name="Incoming" Height="78" MaxLength="24000" ToolTip="Cole o convite ou a resposta completa" AutomationProperties.Name="Convite recebido" TextChanged="IncomingChanged"/>
<WrapPanel Margin="0,10,0,0"><Button x:Name="AcceptButton" Content="Assistir / gerar resposta" Click="AcceptOffer"/><Button x:Name="AnswerButton" Content="Aplicar resposta" Click="ApplyAnswer" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel>
<TextBlock x:Name="OutgoingHint" Text="Copie o texto gerado e envie ao outro lado." Foreground="#A7B6CA" Margin="0,7,0,7"/>
<TextBox x:Name="Outgoing" Height="70" IsReadOnly="True" AutomationProperties.Name="Convite gerado"/>
<WrapPanel Margin="0,9,0,0"><Button x:Name="CopyButton" Content="Copiar texto" Click="CopyCode" IsEnabled="False" Style="{StaticResource Secondary}"/><Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel>
<Button Content="Copiar diagnóstico" Click="CopyDiagnostic" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Margin="0,5,0,0"/>
<Border Height="1" Background="#29364B" Margin="0,14,0,16"/>
<TextBlock Text="Teste sem outro computador" FontWeight="SemiBold"/>
<TextBlock Text="Abre uma janela que recebe sua tela por uma conexão local real." Foreground="#93A4BB" Margin="0,6,0,10"/>
<Button x:Name="SoloButton" Content="Testar neste PC" Click="TestSolo" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/>
<TextBlock Text="Sem conta ou hospedagem. A conexão pela internet usa STUN público e pode falhar em redes restritivas." Foreground="#8294AD" Margin="0,10,0,0" FontSize="11"/>
</StackPanel></ScrollViewer></Border>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="#121C2B" CornerRadius="12" Padding="18" Margin="0,0,0,16"><StackPanel>
<TextBlock x:Name="CaptureTitle" Text="Sua tela" FontSize="20" FontWeight="SemiBold"/>
<TextBlock x:Name="CaptureHelp" Text="A captura só começa quando você clicar no botão abaixo." Foreground="#A7B6CA" Margin="0,7,0,8"/>
<Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><ComboBox x:Name="Displays" AutomationProperties.Name="Monitor"/><ComboBox x:Name="Profiles" Grid.Column="2" AutomationProperties.Name="Qualidade"/></Grid>
<WrapPanel><Button x:Name="StartButton" Content="Iniciar prévia local" Click="StartPreview"/><Button x:Name="StopButton" Content="Parar captura" Click="StopPreview" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel>
</StackPanel></Border>
<Border Grid.Row="1" Background="#060A11" BorderBrush="#26334A" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid><StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock x:Name="PlaceholderText" Text="Sua tela aparece aqui" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="A imagem só é enviada após conectar e iniciar a transmissão." Foreground="#8294AD" Margin="0,10,0,0" TextAlignment="Center"/></StackPanel><Image x:Name="Preview" Stretch="Uniform"/></Grid></Border>
<StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock x:Name="Metrics" Text="Aguardando captura." Foreground="#93A4BB"/><TextBlock x:Name="VideoEngine" Text="A compressão será verificada ao iniciar a transmissão." Foreground="#93A4BB" Margin="0,5,0,0"/></StackPanel>
</Grid></Grid>
<StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="Status" Text="Pronto. Crie um convite, aceite um convite ou teste neste PC." Foreground="#B3C6DF"/><TextBlock Text="Experimental: H.264 com seleção de GPU/CPU. Os perfis são metas; confira os fps medidos. Ainda sem áudio." Foreground="#8294AD" Margin="0,6,0,0" FontSize="11"/></StackPanel>
</Grid></Window>




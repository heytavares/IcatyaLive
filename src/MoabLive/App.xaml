<Application x:Class="MoabLive.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
<Application.Resources>
<Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
<Style TargetType="Button">
 <Setter Property="Padding" Value="15,10"/><Setter Property="Margin" Value="0,0,8,8"/>
 <Setter Property="Background" Value="#7DD3FC"/><Setter Property="Foreground" Value="#101827"/>
 <Setter Property="BorderBrush" Value="#33455E"/><Setter Property="BorderThickness" Value="0"/>
 <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
  <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
   <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
  </Border><ControlTemplate.Triggers>
   <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Opacity" Value="0.85"/></Trigger>
   <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#26354B"/><Setter Property="Foreground" Value="#A8B7CD"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
  </ControlTemplate.Triggers>
 </ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="Secondary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#24344D"/><Setter Property="Foreground" Value="#E7EDF6"/></Style>
<Style TargetType="TextBox"><Setter Property="Background" Value="#0B1320"/><Setter Property="Foreground" Value="#E7EDF6"/><Setter Property="CaretBrush" Value="#7DD3FC"/><Setter Property="BorderBrush" Value="#34445E"/><Setter Property="Padding" Value="9"/><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="VerticalScrollBarVisibility" Value="Auto"/></Style>
<Style TargetType="ComboBox"><Setter Property="Foreground" Value="#142033"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,5,0,12"/></Style>
</Application.Resources>
</Application>


<Window x:Class="Icatya.ShareSettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Compartilhar • iCatya" Icon="/Icatya;component/Assets/Icatya.ico" Width="760" Height="740" MinWidth="650" MinHeight="580"
 ShowInTaskbar="False" WindowStartupLocation="CenterOwner" Background="{DynamicResource AppBackground}"
 Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" FontSize="14">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,18"><TextBlock x:Name="Heading" Text="O que vamos compartilhar?" FontSize="23" FontWeight="SemiBold"/><TextBlock x:Name="Subtitle" Text="Escolha um aplicativo ou uma tela inteira." Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,0"/></StackPanel>
  <Grid x:Name="SourceStep" Grid.Row="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button Content="Atualizar lista" DockPanel.Dock="Right" Style="{StaticResource Secondary}" Click="RefreshSources"/><StackPanel Orientation="Horizontal"><Button x:Name="ApplicationsTab" Content="Aplicações" Click="ShowApplications"/><Button x:Name="ScreensTab" Content="Telas" Style="{StaticResource Secondary}" Click="ShowScreens"/></StackPanel></DockPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><WrapPanel x:Name="SourceCards"/></ScrollViewer>
   <TextBlock Grid.Row="2" x:Name="SourceHint" Text="Uma janela minimizada pode pausar a imagem. Conteúdo protegido pode aparecer preto." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,12,0,10"/>
  </Grid>
  <ScrollViewer x:Name="SettingsStep" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <StackPanel Margin="0,0,8,0">
    <Border Background="{DynamicResource PanelBackground}" Padding="12" CornerRadius="8" Margin="0,0,0,16"><TextBlock x:Name="SelectedName" TextWrapping="Wrap" FontWeight="SemiBold"/></Border>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock Text="Qualidade" FontWeight="SemiBold"/><ComboBox x:Name="Resolution" SelectionChanged="SelectionChanged" AutomationProperties.Name="Qualidade da live"/></StackPanel>
     <StackPanel Grid.Column="2"><TextBlock Text="Quadros por segundo" FontWeight="SemiBold"/><ComboBox x:Name="FrameRate" SelectionChanged="SelectionChanged" AutomationProperties.Name="FPS da live"/></StackPanel>
    </Grid>
    <TextBlock x:Name="Summary" Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,6"/>
    <TextBlock Text="60 fps é experimental. O desempenho depende dos PCs e da conexão." FontSize="12" Foreground="{DynamicResource MutedText}" TextWrapping="Wrap" Margin="0,0,0,22"/>
    <DockPanel Margin="0,0,0,10"><CheckBox x:Name="AudioEnabled" Content="Áudio de aplicativos" FontWeight="SemiBold" Checked="AudioToggled" Unchecked="AudioToggled"/><TextBlock Text="Apenas aplicativos selecionados" Foreground="{DynamicResource SecondaryText}" HorizontalAlignment="Right" FontSize="12"/></DockPanel>
    <Border Background="{DynamicResource PanelBackground}" CornerRadius="10" Padding="12"><StackPanel x:Name="Mixer" IsEnabled="False" Opacity="0.45">
     <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="48"/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><TextBlock Text="Volume master" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="MasterPercent" Grid.Column="1" Text="100%" VerticalAlignment="Center"/><Slider x:Name="MasterVolume" Style="{StaticResource AudioSlider}" Grid.Column="2" Minimum="0" Maximum="100" Value="100" ValueChanged="MasterChanged" AutomationProperties.Name="Volume master da transmissão"/></Grid>
     <StackPanel x:Name="AudioRows"/>
     <Button Content="Atualizar aplicativos de áudio" Click="RefreshAudio" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
    </StackPanel></Border>
    <TextBlock x:Name="AudioHint" Text="Nenhum áudio é capturado até iniciar. Marque só os aplicativos que seus amigos devem ouvir. Navegadores incluem suas abas. O microfone não é capturado." TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,10,0,14"/>
   </StackPanel>
  </ScrollViewer>
  <DockPanel Grid.Row="2" Margin="0,14,0,0"><Button x:Name="BackButton" Content="← Escolher outra fonte" Visibility="Collapsed" DockPanel.Dock="Left" Style="{StaticResource Secondary}" Click="Back"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" IsCancel="True" Style="{StaticResource Secondary}"/><Button x:Name="ConfirmButton" Content="Próximo" IsDefault="True" IsEnabled="False" Click="Confirm" Margin="0,0,0,8"/></StackPanel></DockPanel>
 </Grid>
</Window>

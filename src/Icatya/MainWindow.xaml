<Window x:Class="Icatya.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:Icatya.Controls" Title="iCatya" Icon="/Icatya;component/Assets/Icatya.ico" Width="1440" Height="940" MinWidth="1040" MinHeight="720" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="Segoe UI" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" FontSize="14" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown">
  <Window.Resources>
    <Style x:Key="RoundControl" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Width" Value="54" />
      <Setter Property="Height" Value="54" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0,0,14,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Background" Value="{DynamicResource PanelBackground}" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.38" />
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource RoundControl}">
      <Setter Property="Width" Value="36" />
      <Setter Property="Height" Value="36" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="GearButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
    </Style>
    <Style x:Key="StopControl" TargetType="Button" BasedOn="{StaticResource RoundControl}">
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="True">
          <Setter Property="Background" Value="#332025" />
          <Setter Property="Foreground" Value="#FF6674" />
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#532832" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="LiveBadge" TargetType="Border">
      <Setter Property="Background" Value="#E63E4C" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ParticipantRow" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Margin" Value="0,0,0,6" />
      <Setter Property="Padding" Value="12,11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="FontWeight" Value="Normal" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="selected">
          <Setter Property="Background" Value="{DynamicResource SelectedBackground}" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource Secondary}">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="16,10" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
      <Style.Triggers>
        <Trigger Property="Tag" Value="selected">
          <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
          <Setter Property="Foreground" Value="#171225" />
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="OverlayButton" TargetType="Button" BasedOn="{StaticResource RoundControl}">
      <Setter Property="Width" Value="38" />
      <Setter Property="Height" Value="38" />
      <Setter Property="Margin" Value="4,0" />
      <Setter Property="Background" Value="#ED202127" />
    </Style>
    <Style x:Key="VolumeSlider" TargetType="Slider" BasedOn="{StaticResource AudioSlider}">
      <Setter Property="IsMoveToPointEnabled" Value="True" />
    </Style>
    <Style x:Key="RoomChoiceRow" TargetType="Button" BasedOn="{StaticResource Secondary}"><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Padding" Value="12"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/><Style.Triggers><Trigger Property="Tag" Value="selected"><Setter Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></Style.Triggers></Style>
  </Window.Resources>
  <Grid x:Name="RootLayout" Background="{DynamicResource AppBackground}">
    <Grid x:Name="Workspace">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border x:Name="AppHeader" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Height="66" Padding="20,0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SidebarToggle" Click="ToggleSidebar" Style="{StaticResource IconButton}" ToolTip="Ocultar barra lateral" AutomationProperties.Name="Ocultar barra lateral">
              <Image Source="/Icatya;component/Assets/BrandMark.png" Width="30" Height="30" />
            </Button>
            <TextBlock Text="iCatya" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" Margin="12,0,0,2" />
          </StackPanel>
          <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{DynamicResource MutedText}" Margin="0,0,8,0" />
            <TextBlock x:Name="HeaderConnectionStatus" Text="Fora da sala" Foreground="{DynamicResource SecondaryText}" VerticalAlignment="Center" FontSize="13" />
            <Button x:Name="HeaderSettingsButton" Click="OpenSettings" Style="{StaticResource GearButton}" Visibility="Collapsed" Margin="12,0,0,0" ToolTip="Configurações" AutomationProperties.Name="Configurações">
              <controls:LucideIcon Kind="settings" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>
      <Grid x:Name="ContentGrid" Grid.Row="1" SizeChanged="ContentSizeChanged">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="SidebarColumn" Width="300" MinWidth="220" />
          <ColumnDefinition x:Name="DividerColumn" Width="10" />
          <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>
        <Border x:Name="Sidebar" Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" CornerRadius="0,22,0,0">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="160" />
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource PanelBackground}" CornerRadius="18" Padding="18" Margin="16,18,14,24">
              <StackPanel>
                <Grid>
                  <Button x:Name="JoinRoomButton" Click="JoinRoom" Style="{StaticResource Secondary}" ToolTip="Suas salas (Ctrl+K)" AutomationProperties.Name="Suas salas" Background="Transparent" Margin="0" Padding="0,0,0,6" HorizontalContentAlignment="Stretch">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <StackPanel>
                        <TextBlock x:Name="RoomTitle" Text="Sem sala" FontSize="20" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="RoomDescription" Text="Crie ou entre em uma sala" FontSize="13" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,0" />
                      </StackPanel>
                      <controls:LucideIcon Kind="chevron-down" Grid.Column="1" />
                    </Grid>
                  </Button>
                </Grid>
                <Button x:Name="CopyRoomButton" Click="CopyRoomInvite" Style="{StaticResource Secondary}" Margin="0,18,0,0" Padding="14,12" IsEnabled="False">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="link" Margin="0,0,10,0" />
                    <TextBlock Text="Convidar" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="12,0,12,0">
              <StackPanel>
                <TextBlock Text="PARTICIPANTES" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryText}" Margin="16,0,0,12" />
                <Button x:Name="SelfParticipantButton" Style="{StaticResource ParticipantRow}" Click="OpenOwnStream" ToolTip="Sua transmissão">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:AvatarView x:Name="SelfAvatar" Width="34" Height="34" HorizontalAlignment="Left" />
                    <TextBlock Grid.Column="1" x:Name="SelfNick" Text="Você" FontSize="14" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border x:Name="SelfLive" Style="{StaticResource LiveBadge}" Visibility="Collapsed">
                        <TextBlock Text="AO VIVO" FontSize="9" Foreground="White" />
                      </Border>
                      <Border Background="{DynamicResource SelectedBackground}" CornerRadius="10" Padding="7,3" Margin="5,0,0,0">
                        <TextBlock Text="Você" FontSize="10" Foreground="{DynamicResource SecondaryText}" />
                      </Border>
                    </StackPanel>
                  </Grid>
                </Button>
                <Grid x:Name="RemoteParticipant" Visibility="Collapsed" Margin="12">
                  <TextBlock Text="Amigo conectado" />
                  <Border x:Name="RemoteLive" HorizontalAlignment="Right" Style="{StaticResource LiveBadge}" Visibility="Collapsed">
                    <TextBlock Text="AO VIVO" FontSize="10" Foreground="White" />
                  </Border>
                </Grid>
                <StackPanel x:Name="RoomParticipants" />
                <TextBlock x:Name="ParticipantsHint" Text="Nenhum amigo conectado" Foreground="{DynamicResource MutedText}" Margin="16,8" FontSize="12" />
              </StackPanel>
            </ScrollViewer>
            <Button x:Name="LeaveButton" Grid.Row="2" Click="Disconnect" Style="{StaticResource Secondary}" Background="Transparent" Foreground="#FF5867" IsEnabled="False" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="20,0,20,16" Padding="10,14" ToolTip="Sair da sala" AutomationProperties.Name="Sair da sala">
              <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <controls:LucideIcon Kind="log-out" Margin="0,0,12,0" />
                <TextBlock Text="Sair da sala" />
              </StackPanel>
            </Button>
          </Grid>
        </Border>
        <Border x:Name="ProfileCard" VerticalAlignment="Bottom" Margin="20,0,22,82" Panel.ZIndex="10" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" CornerRadius="12" Padding="12,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="44" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <controls:AvatarView x:Name="FooterAvatar" Width="34" Height="34" HorizontalAlignment="Left" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0">
              <TextBlock x:Name="FooterNick" Text="Meu nick" FontSize="14" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="ProfileConnectionStatus" Text="Fora da sala" Foreground="{DynamicResource MutedText}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
            <Button x:Name="SettingsButton" Grid.Column="2" Click="OpenSettings" Style="{StaticResource GearButton}" ToolTip="Configurações" AutomationProperties.Name="Configurações">
              <controls:LucideIcon Kind="settings" />
            </Button>
          </Grid>
        </Border>
        <GridSplitter x:Name="SidebarDivider" Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="SidebarResized" Background="Transparent" ToolTip="Arraste para ajustar a barra lateral" AutomationProperties.Name="Ajustar largura da barra lateral">
          <GridSplitter.Template>
            <ControlTemplate TargetType="GridSplitter">
              <Grid Background="Transparent">
                <Border x:Name="Grip" Width="2" Height="40" CornerRadius="1" Background="Transparent" />
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </GridSplitter.Template>
        </GridSplitter>
        <Grid Grid.Column="2" Margin="20,22,28,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid x:Name="StageHeading" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid Margin="0,0,12,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <controls:AvatarView x:Name="StageAvatar" Width="46" Height="46" Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="StageTitle" Text="Telas da sala" FontSize="24" FontWeight="SemiBold" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StageSubtitle" Text="Entre em uma sala para começar" Foreground="{DynamicResource SecondaryText}" FontSize="13" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </Grid>
            <Border Grid.Column="1" Background="{DynamicResource PanelBackground}" CornerRadius="14" Padding="4" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <Button x:Name="FocusModeButton" Click="ChooseFocusMode" Style="{StaticResource ModeButton}" ToolTip="Focar uma transmissão">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="monitor" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="Foco" />
                  </StackPanel>
                </Button>
                <Button x:Name="GridModeButton" Click="ExitFocus" Style="{StaticResource ModeButton}" Tag="selected">
                  <StackPanel Orientation="Horizontal">
                    <controls:LucideIcon Kind="layout-grid" Width="18" Height="18" Margin="0,0,8,0" />
                    <TextBlock Text="Grade" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>
          </Grid>
          <Border Grid.Row="1" Background="#0C0D10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
            <Grid x:Name="LiveSurface" MouseEnter="LiveSurfaceActivity" MouseMove="LiveSurfaceActivity" MouseLeave="LiveSurfaceLeft" PreviewKeyDown="LiveSurfaceKeyDown">
              <StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                <controls:LucideIcon Kind="monitor" Width="44" Height="44" Foreground="{DynamicResource MutedText}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock x:Name="PlaceholderText" Text="Nenhuma transmissão aberta" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                <TextBlock Text="Compartilhe uma tela ou escolha uma live na lista de participantes." Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,0" TextAlignment="Center" MaxWidth="340" />
              </StackPanel>
              <Image x:Name="Preview" Stretch="Uniform" />
              <Grid x:Name="RoomStage" Visibility="Collapsed" Background="#0C0D10">
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <controls:VideoGridPanel x:Name="RoomVideos" Grid.Row="0" Margin="10" />
                <Grid x:Name="FocusSurface" Grid.Row="0" Visibility="Collapsed">
                  <Grid x:Name="FocusHost" />
                  <Button x:Name="ExitFocusButton" Click="ExitFocus" GotKeyboardFocus="FocusBackFocused" LostKeyboardFocus="FocusBackUnfocused" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="2" Margin="14,54,14,14" Padding="10,8" FontSize="12" Opacity="0" IsHitTestVisible="False" Style="{StaticResource Secondary}" Background="#ED202127" ToolTip="Voltar à grade (Esc)" AutomationProperties.Name="Voltar à grade">
                    <StackPanel Orientation="Horizontal">
                      <controls:LucideIcon Kind="layout-grid" Width="16" Height="16" Margin="0,0,6,0" />
                      <TextBlock Text="Voltar à grade" />
                    </StackPanel>
                  </Button>
                  <StackPanel x:Name="FocusControls" HorizontalAlignment="Center" VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,0,14" Opacity="0" IsHitTestVisible="False">
                    <Button x:Name="ToggleThumbnailsButton" Click="ToggleThumbnails" GotKeyboardFocus="FocusToggleFocused" LostKeyboardFocus="FocusToggleUnfocused" Style="{StaticResource OverlayButton}" ToolTip="Ocultar miniaturas" AutomationProperties.Name="Ocultar miniaturas">
                      <Path x:Name="FocusTrayArrow" Width="14" Height="8" Stretch="Fill" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Data="M1,1 L8,8 15,1" />
                    </Button>
                    <Button x:Name="CloseStreamButton" Click="CloseFocusedStream" GotKeyboardFocus="FocusToggleFocused" LostKeyboardFocus="FocusToggleUnfocused" Style="{StaticResource OverlayButton}" ToolTip="Fechar esta live só para você" AutomationProperties.Name="Fechar transmissão recebida">
                      <controls:LucideIcon Kind="x" Width="19" Height="19" />
                    </Button>
                  </StackPanel>
                </Grid>
                <ScrollViewer x:Name="ThumbnailScroll" Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="10,10,10,8" HorizontalContentAlignment="Center">
                  <StackPanel x:Name="RoomThumbnails" HorizontalAlignment="Center" Orientation="Horizontal" />
                </ScrollViewer>
              </Grid>
              <Border x:Name="PlaybackOverlay" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#ED191A20" CornerRadius="12" Padding="7,4" Margin="14" Opacity="0" IsHitTestVisible="False" GotKeyboardFocus="FocusToggleFocused" LostKeyboardFocus="FocusToggleUnfocused" ToolTip="Volume das transmissões recebidas">
                <StackPanel Orientation="Horizontal">
                  <Button x:Name="PlaybackMute" Width="30" Height="28" Padding="0" Margin="0,0,6,0" Style="{StaticResource IconButton}" Click="MutePlayback" AutomationProperties.Name="Silenciar ou restaurar áudio recebido">
                    <Grid>
                      <controls:LucideIcon Kind="volume-2" Width="18" Height="18" />
                      <Path x:Name="PlaybackMutedMark" Visibility="Collapsed" Stroke="{DynamicResource PrimaryText}" StrokeThickness="2" Data="M2,2 L20,20" Width="22" Height="22" />
                    </Grid>
                  </Button>
                  <Slider x:Name="PlaybackVolume" Width="100" Minimum="0" Maximum="100" Value="65" ValueChanged="PlaybackVolumeChanged" Style="{StaticResource VolumeSlider}" AutomationProperties.Name="Volume das transmissões recebidas" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,22,0,6" MinHeight="58">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
              <StackPanel Orientation="Horizontal">
                <controls:LucideIcon Kind="info" Width="15" Height="15" Foreground="{DynamicResource SecondaryText}" Margin="0,0,8,0" />
                <TextBlock x:Name="CaptureTitle" Text="Seu compartilhamento está parado" Foreground="{DynamicResource SecondaryText}" FontSize="12" VerticalAlignment="Center" />
              </StackPanel>
              <TextBlock x:Name="Metrics" Text="" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="23,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Button x:Name="CameraButton" IsEnabled="False" Style="{StaticResource RoundControl}" ToolTip="Câmera indisponível · em breve" ToolTipService.ShowOnDisabled="True" AutomationProperties.Name="Câmera indisponível">
                <controls:LucideIcon Kind="camera" Width="23" Height="23" />
              </Button>
              <Button x:Name="ShareButton" Click="OpenShareSettings" Style="{StaticResource RoundControl}" Background="{DynamicResource AccentBrush}" Foreground="#171225" BorderBrush="#C6B7FF" ToolTip="Compartilhar tela / configurar qualidade" AutomationProperties.Name="Configurar compartilhamento">
                <controls:LucideIcon Kind="monitor-up" Width="24" Height="24" />
              </Button>
              <Button x:Name="StopButton" Click="StopPreview" IsEnabled="False" Style="{StaticResource StopControl}" ToolTip="Parar compartilhamento" AutomationProperties.Name="Parar compartilhamento" Margin="0">
                <controls:LucideIcon Kind="monitor-x" Width="24" Height="24" />
              </Button>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
      <TextBlock x:Name="Status" Grid.Row="2" Text="Pronto." Foreground="{DynamicResource MutedText}" FontSize="11" Margin="24,0,24,8" />
    </Grid>
        <Popup x:Name="RoomPicker" Placement="Bottom" PlacementTarget="{Binding ElementName=JoinRoomButton}" VerticalOffset="10" AllowsTransparency="True" StaysOpen="False" Opened="RoomPickerOpened" Closed="RoomPickerClosed">
      <Border x:Name="RoomPickerCard" Width="392" MaxHeight="570" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Padding="16" TextElement.Foreground="{DynamicResource PrimaryText}" PreviewKeyDown="RoomPickerKeyDown">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid Margin="4,0,4,14"><TextBlock Text="Suas salas" FontSize="18" FontWeight="SemiBold"/><Border HorizontalAlignment="Right" Background="{DynamicResource SelectedBackground}" CornerRadius="6" Padding="7,3"><TextBlock Text="Ctrl + K" FontSize="11" Foreground="{DynamicResource SecondaryText}"/></Border></Grid>
          <Grid Grid.Row="1" Margin="0,0,0,12"><TextBox x:Name="RoomSearch" MaxLength="48" Height="42" Padding="38,9,10,9" TextWrapping="NoWrap" AcceptsReturn="False" TextChanged="RoomSearchChanged" AutomationProperties.Name="Buscar sala"/><controls:LucideIcon Kind="search" Width="18" Height="18" Margin="12,0,0,0" HorizontalAlignment="Left" Foreground="{DynamicResource SecondaryText}"/><TextBlock x:Name="RoomSearchPlaceholder" Text="Buscar sala" Margin="38,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedText}" IsHitTestVisible="False"/></Grid>
          <ScrollViewer Grid.Row="2" MaxHeight="276" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><StackPanel x:Name="SavedRoomChoices"/><TextBlock x:Name="EmptyRoomChoices" Text="Nenhuma sala encontrada" Foreground="{DynamicResource SecondaryText}" Margin="12,18" Visibility="Collapsed"/></StackPanel></ScrollViewer>
          <StackPanel Grid.Row="3"><TextBlock x:Name="RoomDirectoryStatus" Text="" FontSize="11" Foreground="{DynamicResource MutedText}" Margin="4,9,4,6" TextWrapping="Wrap"/><Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,12"/>
            <Button x:Name="RenameRoomButton" Click="BeginRenameRoom" Style="{StaticResource Secondary}" Background="Transparent" HorizontalAlignment="Stretch" Margin="0,0,0,8" IsEnabled="False"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="pencil" Width="16" Height="16" Margin="0,0,8,0"/><TextBlock Text="Renomear sala atual"/></StackPanel></Button>
            <StackPanel x:Name="RenameRoomPanel" Visibility="Collapsed" Margin="4,0,4,12"><TextBlock Text="Nome visível para todos na sala" FontSize="12" Foreground="{DynamicResource SecondaryText}" Margin="0,0,0,6"/><TextBox x:Name="NewRoomName" MaxLength="48" TextWrapping="NoWrap" AcceptsReturn="False" AutomationProperties.Name="Novo nome da sala"/><TextBlock x:Name="RenameRoomError" Foreground="#FF8994" FontSize="12" Margin="0,5,0,5"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Cancelar" Click="CancelRenameRoom" Style="{StaticResource Secondary}" Margin="0,4,6,0" Padding="12,8"/><Button x:Name="SaveRoomNameButton" Content="Salvar nome" Click="SaveRoomName" Margin="0,4,0,0" Padding="12,8"/></StackPanel></StackPanel>
          </StackPanel>
          <Grid Grid.Row="4"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="CreateSavedRoomButton" Click="CreateSavedRoom" Style="{StaticResource Secondary}" Background="Transparent" Foreground="{DynamicResource AccentText}" Margin="0" Padding="8,10"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="plus" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Criar sala"/></StackPanel></Button><Border Grid.Column="1" Width="1" Background="{DynamicResource BorderBrush}" Margin="4,6"/><Button x:Name="JoinSavedRoomButton" Grid.Column="2" Click="JoinSavedRoom" Style="{StaticResource Secondary}" Background="Transparent" Foreground="{DynamicResource AccentText}" Margin="0" Padding="8,10"><StackPanel Orientation="Horizontal"><controls:LucideIcon Kind="link" Width="17" Height="17" Margin="0,0,6,0"/><TextBlock Text="Entrar com convite" FontSize="12"/></StackPanel></Button></Grid>
        </Grid>
      </Border>
    </Popup>

<Grid x:Name="SettingsOverlay" Visibility="Collapsed" Background="#AA000000" KeyboardNavigation.TabNavigation="Cycle">
      <Border Width="510" MaxHeight="{Binding ActualHeight, ElementName=RootLayout}" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="24" Margin="14" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <Grid Margin="0,0,0,16">
            <TextBlock Text="Configurações" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
            <Button x:Name="SettingsClose" Click="CloseSettings" HorizontalAlignment="Right" Style="{StaticResource IconButton}" ToolTip="Fechar configurações" AutomationProperties.Name="Fechar configurações">
              <Path Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.8" Data="M0,0 L14,14 M14,0 L0,14" Width="14" Height="14" />
            </Button>
          </Grid>
          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
              <TextBlock Text="Seu avatar" FontSize="17" FontWeight="SemiBold" Margin="0,2,0,10" />
              <WrapPanel x:Name="AvatarChoices" />
              <Button xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Content="Trocar meu nick" Click="ChangeNick" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,8,0,12" />
              <TextBlock x:Name="AvatarSelectionStatus" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,4,0,12" />
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,16" />
              <TextBlock Text="iCatya" FontSize="19" FontWeight="SemiBold" />
              <TextBlock Text="Versão 1.0.0" Foreground="{DynamicResource SecondaryText}" Margin="0,5,0,12" />
              <Button x:Name="UpdateButton" Content="Verificar atualizações" Click="CheckForUpdate" HorizontalAlignment="Left" />
              <TextBlock x:Name="UpdateStatus" Text="" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap" Margin="0,3,0,12" />
              <TextBlock x:Name="SettingsStatus" Text="Sala e nick ficam salvos neste PC." Foreground="{DynamicResource AccentText}" FontSize="12" Margin="0,6,0,10" />
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,8,0,18" />
              <TextBlock Text="Detalhes da transmissão" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,8" />
              <TextBlock x:Name="VideoEngine" Text="" Foreground="{DynamicResource MutedText}" FontSize="10" Margin="23,2,0,0" />
              <StackPanel Orientation="Horizontal" Margin="23,2,0,0">
                <TextBlock x:Name="AudioState" Text="Áudio desligado" Foreground="{DynamicResource MutedText}" FontSize="10" />
                <Border x:Name="AudioLevelTrack" Visibility="Collapsed" Width="42" Height="4" Background="{DynamicResource BorderBrush}" CornerRadius="2" Margin="8,0,0,0">
                  <Border x:Name="AudioLevel" Background="{DynamicResource SuccessBrush}" HorizontalAlignment="Left" Width="0" CornerRadius="2" />
                </Border>
              </StackPanel>
              <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,16" />
              <Button Content="Copiar diagnóstico" Click="CopyDiagnostic" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Margin="0,5,0,0" />
              <StackPanel xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Margin="0,18,0,2">
                <TextBlock Text="Ajuda" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Problemas com o app? Fale comigo no Discord:" Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,4" />
                <TextBlock Text="fvckjax" FontSize="16" FontWeight="SemiBold" />
                <Button Content="Copiar usuário do Discord" Click="CopySupportDiscord" Style="{StaticResource Secondary}" HorizontalAlignment="Left" Margin="0,10,0,0" />
              </StackPanel>
              <Expander x:Name="AdvancedConnection" Header="Avançado · conexão manual" IsExpanded="False" Margin="0,16,0,0">
                <StackPanel Margin="0,14,0,0">
                  <TextBlock Text="Conexão manual" FontSize="20" FontWeight="SemiBold" />
                  <TextBlock x:Name="RoleHint" Text="Escolha: transmitir sua tela ou assistir a outro PC." Foreground="{DynamicResource AccentText}" Margin="0,10,0,8" FontWeight="SemiBold" />
                  <TextBlock Text="1. Quem compartilha cria o convite." Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,8" />
                  <Button x:Name="OfferButton" Content="Criar convite para transmitir" Click="CreateOffer" HorizontalAlignment="Left" />
                  <TextBlock x:Name="IncomingHint" Text="Para assistir, cole o convite recebido abaixo." Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,7" />
                  <TextBox x:Name="Incoming" Height="78" MaxLength="24000" ToolTip="Cole o convite ou a resposta completa" AutomationProperties.Name="Convite recebido" TextChanged="IncomingChanged" />
                  <WrapPanel Margin="0,10,0,0">
                    <Button x:Name="AcceptButton" Content="Assistir / gerar resposta" Click="AcceptOffer" />
                    <Button x:Name="AnswerButton" Content="Aplicar resposta" Click="ApplyAnswer" IsEnabled="False" Style="{StaticResource Secondary}" />
                  </WrapPanel>
                  <TextBlock x:Name="OutgoingHint" Text="Copie o texto gerado e envie ao outro lado." Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,7" />
                  <TextBox x:Name="Outgoing" Height="70" IsReadOnly="True" AutomationProperties.Name="Convite gerado" />
                  <WrapPanel Margin="0,9,0,0">
                    <Button x:Name="CopyButton" Content="Copiar texto" Click="CopyCode" IsEnabled="False" Style="{StaticResource Secondary}" />
                    <Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect" IsEnabled="False" Style="{StaticResource Secondary}" />
                  </WrapPanel>
                  <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,16" />
                  <TextBlock Text="Sem login. As salas usam um serviço de encontro; o vídeo vai entre os PCs. Redes restritivas podem impedir a conexão direta." Foreground="{DynamicResource MutedText}" Margin="0,10,0,0" FontSize="12" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>

<Window x:Class="Icatya.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Icatya · Conexão direta" Icon="/Assets/Icatya.ico" Width="1240" Height="900" MinWidth="1040" MinHeight="760" Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="gg sans, Segoe UI Variable Text, Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
<Window.Resources>
<Style x:Key="RoundControl" TargetType="Button" BasedOn="{StaticResource Secondary}">
<Setter Property="Width" Value="44"/><Setter Property="Height" Value="44"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,10,0"/>
<Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="22"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
</Style>
<Style x:Key="StopControl" TargetType="Button" BasedOn="{StaticResource RoundControl}"><Setter Property="Background" Value="#DA373C"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F13F4C"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#B0212C"/></Trigger></Style.Triggers></Style>
</Window.Resources>
<Grid Margin="20"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,0,0,16"><StackPanel Margin="52,0,160,0"><TextBlock Text="Icatya" FontSize="30" FontWeight="Bold"/><TextBlock Text="Tela por conexão direta. Continue na chamada de voz do Discord." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/></StackPanel><Button x:Name="SidebarToggle" HorizontalAlignment="Left" VerticalAlignment="Top" Click="ToggleSidebar" Style="{StaticResource RoundControl}" ToolTip="Ocultar barra lateral" AutomationProperties.Name="Ocultar barra lateral"><Path Width="18" Height="16" Stretch="Fill" Stroke="White" StrokeThickness="1.5" Data="M1,1 L21,1 21,17 1,17 Z M7,1 L7,17"/></Button><StackPanel HorizontalAlignment="Right" VerticalAlignment="Top"><Button Content="Atualizar" Click="CheckForUpdate" Style="{StaticResource Secondary}" Margin="0,0,0,6" Padding="12,6" FontSize="13"/><Border Background="{DynamicResource SelectedBackground}" CornerRadius="12" Padding="14,8"><TextBlock Text="0.5.2" Foreground="{DynamicResource AccentText}" FontSize="12" FontWeight="SemiBold"/></Border></StackPanel></Grid>
<Grid x:Name="ContentGrid" Grid.Row="1" SizeChanged="ContentSizeChanged"><Grid.ColumnDefinitions><ColumnDefinition x:Name="SidebarColumn" Width="360" MinWidth="220"/><ColumnDefinition x:Name="DividerColumn" Width="12"/><ColumnDefinition Width="*" MinWidth="260"/></Grid.ColumnDefinitions>
<Border x:Name="Sidebar" Background="{DynamicResource SidebarBackground}" CornerRadius="12" Padding="18"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Conectar" FontSize="20" FontWeight="SemiBold"/>
<TextBlock x:Name="RoleHint" Text="Escolha: transmitir sua tela ou assistir a outro PC." Foreground="{DynamicResource AccentText}" Margin="0,10,0,8" FontWeight="SemiBold"/>
<TextBlock Text="1. Quem compartilha cria o convite." Foreground="{DynamicResource SecondaryText}" Margin="0,10,0,8"/>
<Button x:Name="OfferButton" Content="Criar convite para transmitir" Click="CreateOffer" HorizontalAlignment="Left"/>
<TextBlock x:Name="IncomingHint" Text="Para assistir, cole o convite recebido abaixo." Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,7"/>
<TextBox x:Name="Incoming" Height="78" MaxLength="24000" ToolTip="Cole o convite ou a resposta completa" AutomationProperties.Name="Convite recebido" TextChanged="IncomingChanged"/>
<WrapPanel Margin="0,10,0,0"><Button x:Name="AcceptButton" Content="Assistir / gerar resposta" Click="AcceptOffer"/><Button x:Name="AnswerButton" Content="Aplicar resposta" Click="ApplyAnswer" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel>
<TextBlock x:Name="OutgoingHint" Text="Copie o texto gerado e envie ao outro lado." Foreground="{DynamicResource SecondaryText}" Margin="0,7,0,7"/>
<TextBox x:Name="Outgoing" Height="70" IsReadOnly="True" AutomationProperties.Name="Convite gerado"/>
<WrapPanel Margin="0,9,0,0"><Button x:Name="CopyButton" Content="Copiar texto" Click="CopyCode" IsEnabled="False" Style="{StaticResource Secondary}"/><Button x:Name="DisconnectButton" Content="Desconectar" Click="Disconnect" IsEnabled="False" Style="{StaticResource Secondary}"/></WrapPanel>
<Button Content="Copiar diagnóstico" Click="CopyDiagnostic" HorizontalAlignment="Left" Style="{StaticResource Secondary}" Margin="0,5,0,0"/>
<Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,14,0,16"/>
<TextBlock Text="Teste sem outro computador" FontWeight="SemiBold"/>
<TextBlock Text="Abre uma janela que recebe sua tela por uma conexão local real." Foreground="{DynamicResource SecondaryText}" Margin="0,6,0,10"/>
<Button x:Name="SoloButton" Content="Testar neste PC" Click="TestSolo" HorizontalAlignment="Left" Style="{StaticResource Secondary}"/>
<TextBlock Text="Sem conta ou hospedagem. A conexão pela internet usa STUN público e pode falhar em redes restritivas." Foreground="{DynamicResource MutedText}" Margin="0,10,0,0" FontSize="12"/>
</StackPanel></ScrollViewer></Border>
<GridSplitter x:Name="SidebarDivider" Grid.Column="1" Width="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ShowsPreview="False" DragCompleted="SidebarResized" Background="Transparent" ToolTip="Arraste para ajustar a barra lateral" AutomationProperties.Name="Ajustar largura da barra lateral">
  <GridSplitter.Template><ControlTemplate TargetType="GridSplitter"><Grid Background="Transparent"><Border x:Name="Grip" Width="3" Height="48" CornerRadius="2" Background="{DynamicResource BorderBrush}"/></Grid><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></GridSplitter.Template>
</GridSplitter>
<Grid Grid.Column="2"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Background="{DynamicResource SidebarBackground}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid><StackPanel x:Name="Placeholder" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20"><TextBlock x:Name="PlaceholderText" Text="Sua tela aparece aqui" FontSize="22" HorizontalAlignment="Center"/><TextBlock Text="Use o botão de compartilhar abaixo para escolher a tela e a qualidade." Foreground="{DynamicResource MutedText}" Margin="0,10,0,0" TextAlignment="Center"/></StackPanel><Image x:Name="Preview" Stretch="Uniform"/></Grid></Border>
<Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock x:Name="CaptureTitle" Text="Sua tela" FontWeight="SemiBold"/><TextBlock x:Name="Metrics" Text="Aguardando captura." Foreground="{DynamicResource SecondaryText}" Margin="0,4,0,0"/><TextBlock x:Name="VideoEngine" Text="" Foreground="{DynamicResource MutedText}" FontSize="12" Margin="0,3,0,0"/></StackPanel>
<StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
<Button x:Name="ShareButton" Click="OpenShareSettings" Style="{StaticResource RoundControl}" ToolTip="Compartilhar tela / configurar qualidade" AutomationProperties.Name="Configurar compartilhamento">
  <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M4,4 L20,4 20,17 4,17 Z M9,21 L15,21 M12,17 L12,21"/><Path Fill="White" Data="M12,6 L17,11 14,11 14,15 10,15 10,11 7,11 Z"/></Canvas></Viewbox>
</Button>
<Button x:Name="StopButton" Click="StopPreview" IsEnabled="False" Style="{StaticResource StopControl}" ToolTip="Parar compartilhamento" AutomationProperties.Name="Parar compartilhamento" Margin="0">
  <Viewbox Width="22" Height="22"><Canvas Width="24" Height="24"><Path Stroke="White" StrokeThickness="1.8" StrokeLineJoin="Round" Data="M15,4 L3,4 3,17 20,17 20,11 M8,21 L15,21 M11.5,17 L11.5,21 M18,2 L23,7 M23,2 L18,7"/></Canvas></Viewbox>
</Button>
</StackPanel></Grid>
</Grid></Grid>
<StackPanel Grid.Row="2" Margin="0,16,0,0"><TextBlock x:Name="Status" Text="Pronto. Crie um convite, aceite um convite ou teste neste PC." Foreground="{DynamicResource SecondaryText}"/><TextBlock Text="Experimental: H.264 com seleção de GPU/CPU. Os perfis são metas; confira os fps medidos. Ainda sem áudio." Foreground="{DynamicResource MutedText}" Margin="0,6,0,0" FontSize="12"/></StackPanel>
</Grid></Window>






